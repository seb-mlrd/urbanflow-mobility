{
  "name": "urbanflow",
  "version": "1.0.0",
  "private": true,
  "description": "UrbanFlow Mobility — PWA de mobilité urbaine (Next.js + NestJS)",
  "scripts": {
    "dev": "pnpm --parallel --filter \"@urbanflow/*\" dev",
    "build": "pnpm --recursive --filter \"@urbanflow/*\" build",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive test",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
