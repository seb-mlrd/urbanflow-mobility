# Copier ce fichier en .env.local et remplir les valeurs

# --- Base de données PostgreSQL ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=urbanflow

# --- apps/web (port 3000) ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- apps/api (port 3001) ---
PORT=3001
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
JWT_SECRET=
JWT_REFRESH_SECRET=
REDIS_URL=redis://localhost:6379

# --- OpenTripPlanner (port 8888) ---
OTP_GRAPHQL_URL=http://localhost:8888/otp/gtfs/v1

# --- GBFS V'Lille (Ilevia) ---
# Découverte : https://media.ilevia.fr/opendata/gbfs.json
GBFS_VLILLE_STATION_INFORMATION_URL=https://media.ilevia.fr/opendata/station_information.json
GBFS_VLILLE_STATION_STATUS_URL=https://media.ilevia.fr/opendata/station_status.json

# --- GBFS Lime (trottinettes uniquement, e-bikes filtrés) ---
# Découverte : https://data.lime.bike/api/partners/v2/gbfs/lille/gbfs.json
GBFS_LIME_FREE_BIKE_STATUS_URL=https://data.lime.bike/api/partners/v2/gbfs/lille/free_bike_status
